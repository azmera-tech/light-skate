# Copy this file to ".env" in this same folder, then edit DATABASE_URL below to point at your PostgreSQL database.
# Everything else already has a safe default for trying the app out on your own computer (Windows, Mac or Linux).
# This file is loaded automatically — you do not need to run "export" or "$env:" for anything in here.

# ---- Required: your database connection ----
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/lightskate
# On Supabase: use the DIRECT connection (port 5432, host db.<project-ref>.supabase.co) or the
# "Session" pooler — NOT the "Transaction" pooler (port 6543). The realtime hub uses LISTEN/NOTIFY,
# which the transaction pooler does not support (each query there can land on a different backend
# connection, so a LISTEN registered on one is invisible to the next).
# TLS is auto-detected from the host (any non-localhost host gets SSL); set DB_SSL=true/false to override.
# DB_SSL=true

# ---- Required only in production (leave these as-is for local testing) ----
# NODE_ENV=production
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs short-lived photo URLs. Required when NODE_ENV=production.
SIGNING_SECRET=

# ---- Server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Serve the built web app from the API process (default ../web/dist relative to backend/)
WEB_DIR=../web/dist

# ---- Background worker ----
# true  = worker runs inside the API process (simplest, single node — use this for local testing)
# false = run `npm run worker` as a separate process/container (can run several; they coordinate with SKIP LOCKED)
EMBEDDED_WORKER=true
WORKER_TICK_MS=5000

# ---- Storage (customer / incident / maintenance photos) ----
# local    = disk folder below (fine for local dev, NOT for production — Render's filesystem is
#            ephemeral, so photos would vanish on every deploy/restart)
# supabase = Supabase Storage (production). Needs SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY below.
STORAGE_DRIVER=local
# Relative path = a "storage-data" folder inside backend/ (already set up to be ignored by git).
STORAGE_DIR=./storage-data
MAX_UPLOAD_BYTES=5242880
PHOTO_MIN_DIM=64
PHOTO_MAX_DIM=4096
SIGNED_URL_TTL_SECONDS=60

# ---- Required only when STORAGE_DRIVER=supabase ----
# Project Settings -> API in the Supabase dashboard.
# SUPABASE_URL=https://<project-ref>.supabase.co
# The service_role key (NOT the anon/publishable key) — it bypasses Storage policies, which is
# required since this backend is the only thing ever allowed to touch the bucket. Keep it secret.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=light-skate-photos

# ---- Auth ----
SESSION_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Misc ----
RATE_LIMIT_ENABLED=true
DB_POOL_MAX=20
# Only used by `npm run seed`. Leave blank to use the default shown when the seed finishes.
DEMO_PASSWORD=
