# This file is for `docker compose` only (docker-compose.yml substitutes ${POSTGRES_PASSWORD} / ${SIGNING_SECRET}
# from a .env file in this same directory — that's a Docker Compose convention, not something Light Skate reads).
#
#   cp .env.example .env   # then fill in real values, and docker compose up -d --build picks them up automatically
#
# Running the app WITHOUT Docker? You don't need this file — use backend/.env instead (see backend/.env.example).

POSTGRES_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -hex 32`
SIGNING_SECRET=
