# ---- Required in production ----
NODE_ENV=production
DATABASE_URL=postgres://lightskate:CHANGE_ME@db:5432/lightskate
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs short-lived photo URLs. The API refuses to start in production without it.
SIGNING_SECRET=

# ---- Server ----
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Serve the built web app from the API process (default ../web/dist relative to backend/)
WEB_DIR=../web/dist

# ---- Background worker ----
# true  = worker runs inside the API process (simplest, single node)
# false = run `npm run worker` as a separate process/container (can run several; they coordinate with SKIP LOCKED)
EMBEDDED_WORKER=true
WORKER_TICK_MS=5000

# ---- Storage (customer / incident / maintenance photos) ----
STORAGE_DRIVER=local
# Must NOT be inside a web-served directory. Mount a persistent, backed-up volume here.
STORAGE_DIR=/var/lib/light-skate/storage
MAX_UPLOAD_BYTES=5242880
PHOTO_MIN_DIM=64
PHOTO_MAX_DIM=4096
SIGNED_URL_TTL_SECONDS=60

# ---- Auth ----
SESSION_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Misc ----
RATE_LIMIT_ENABLED=true
DB_POOL_MAX=20
# Only used by `npm run seed`
DEMO_PASSWORD=
